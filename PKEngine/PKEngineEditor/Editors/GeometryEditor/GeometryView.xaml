<UserControl x:Class="PKEngineEditor.Editors.GeometryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PKEngineEditor.Editors"
             d:DataContext="{d:DesignInstance Type = local:MeshRenderer}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Background="Transparent"
          MouseLeftButtonDown="OnGrid_Mouse_LBD" MouseMove="OnGrid_MouseMove"
          MouseLeftButtonUp="OnGrid_Mouse_LBU" MouseWheel="OnGrid_MouseWheel"
          MouseRightButtonDown="OnGrid_Mouse_RBD" MouseRightButtonUp="OnGrid_Mouse_RBU">
        <Viewport3D x:Name="viewport" IsHitTestVisible="False">
            <Viewport3D.Camera>
                <PerspectiveCamera FarPlaneDistance="10000" NearPlaneDistance="0.001" FieldOfView="45" Position="{Binding OffsetCameraPosition}"
                                   UpDirection="0,1,0" LookDirection="{Binding CameraDirection}" />
            </Viewport3D.Camera>

            <Viewport3D.Children>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <DirectionalLight Color="{Binding KeyLight}" Direction="{Binding CameraDirection}" />
                            <DirectionalLight Color="{Binding SkyLight}" Direction="0,-1,0" />
                            <DirectionalLight Color="{Binding GroundLight}" Direction="0,1,0" />
                            <AmbientLight Color="{Binding AmbientLight}" />
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- Axis Gizmo -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <!-- X Axis (Red) -->
                            <GeometryModel3D>
                                <GeometryModel3D.Transform>
                                    <TranslateTransform3D OffsetX="1" OffsetY="0" OffsetZ="0" />
                                </GeometryModel3D.Transform>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D Positions="0,-0.02,-0.02  2,-0.02,-0.02  2,0.02,-0.02  0,0.02,-0.02
                                                              0,-0.02,0.02   2,-0.02,0.02   2,0.02,0.02   0,0.02,0.02"
                                                    TriangleIndices="0 1 2 0 2 3  4 6 5 4 7 6  0 4 5 0 5 1
                                                                     1 5 6 1 6 2  2 6 7 2 7 3  0 3 7 0 7 4" />
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="Red" />
                                </GeometryModel3D.Material>
                            </GeometryModel3D>

                            <!-- Y Axis (Green) -->
                            <GeometryModel3D>
                                <GeometryModel3D.Transform>
                                    <TranslateTransform3D OffsetX="0" OffsetY="1" OffsetZ="0" />
                                </GeometryModel3D.Transform>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D Positions="-0.02,0,-0.02  -0.02,2,-0.02  0.02,2,-0.02  0.02,0,-0.02
                                                              -0.02,0,0.02   -0.02,2,0.02   0.02,2,0.02   0.02,0,0.02"
                                                    TriangleIndices="0 1 2 0 2 3  4 6 5 4 7 6  0 4 5 0 5 1
                                                                     1 5 6 1 6 2  2 6 7 2 7 3  0 3 7 0 7 4" />
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="Green" />
                                </GeometryModel3D.Material>
                            </GeometryModel3D>

                            <!-- Z Axis (Blue) -->
                            <GeometryModel3D>
                                <GeometryModel3D.Transform>
                                    <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="1" />
                                </GeometryModel3D.Transform>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D Positions="-0.02,-0.02,0  -0.02,-0.02,2  -0.02,0.02,2  -0.02,0.02,0
                                                               0.02,-0.02,0   0.02,-0.02,2   0.02,0.02,2   0.02,0.02,0"
                                                    TriangleIndices="0 1 2 0 2 3  4 6 5 4 7 6  0 4 5 0 5 1
                                                                     1 5 6 1 6 2  2 6 7 2 7 3  0 3 7 0 7 4" />
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="Blue" />
                                </GeometryModel3D.Material>
                            </GeometryModel3D>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </Viewport3D.Children>
        </Viewport3D>
    </Grid>
</UserControl>