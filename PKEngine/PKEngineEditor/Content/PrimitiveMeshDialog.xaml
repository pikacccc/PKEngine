<Window x:Class="PKEngineEditor.Content.PrimitiveMeshDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PKEngineEditor.Content"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:util="clr-namespace:PKEngineEditor.Utilities.Controls"
        mc:Ignorable="d" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Title="PrimitiveMeshDialog" Height="600" Width="800"
        Style="{StaticResource PkDialogStyle}">
    <Window.Resources>
        <ObjectDataProvider x:Key="dataFromEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:PrimitiveMeshType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <DockPanel Background="{StaticResource Editor.Window.GrayBrush2}">
        <Border Background="{StaticResource Editor.Window.GrayBrush3}" Height="32" DockPanel.Dock="Top"
                VerticalAlignment="Top" Margin="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Opacity="0.3" BlurRadius="10" ShadowDepth="0" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <ComboBox SelectedIndex="0" Width="100" VerticalAlignment="Center" x:Name="primTypeComboBox"
                          SelectionChanged="OnPrimitiveType_ComboBox_SelectionChanged"
                          ItemsSource="{Binding Source={StaticResource dataFromEnum}}" />
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="100" MaxWidth="200" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Background="{StaticResource Editor.Window.GrayBrush3}">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedItem, ElementName=primTypeComboBox}"
                                         Value="{x:Static local:PrimitiveMeshType.Plane}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,5">
                    <Border CornerRadius="3" BorderBrush="{StaticResource Editor.Window.GrayBrush6}"
                            BorderThickness="1" Margin="5">
                        <StackPanel Margin="5,15,5,5">
                            <DockPanel Margin="5">
                                <TextBlock Text="Width" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Foreground="{StaticResource Editor.FontBrush}" />
                                <TextBox Text="{Binding ElementName=xSliderPlane, Path=Value}" Width="30"
                                         DockPanel.Dock="Right" />
                                <Slider Minimum="1" Maximum="10" HorizontalAlignment="Stretch" Interval="1"
                                        IsSnapToTickEnabled="True"
                                        TickPlacement="BottomRight" x:Name="xSliderPlane"
                                        ValueChanged="OnSlider_ValueChanged" />
                            </DockPanel>
                            <DockPanel Margin="5">
                                <TextBlock Text="Length" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Foreground="{StaticResource Editor.FontBrush}" />
                                <TextBox Text="{Binding ElementName=zSliderPlane, Path=Value}" Width="30"
                                         DockPanel.Dock="Right" />
                                <Slider Minimum="1" Maximum="10" HorizontalAlignment="Stretch" Interval="1"
                                        IsSnapToTickEnabled="True"
                                        TickPlacement="BottomRight" x:Name="zSliderPlane"
                                        ValueChanged="OnSlider_ValueChanged" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Label Content="Segments" Background="{StaticResource Editor.Window.GrayBrush3}"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left" Margin="20,-3,0,0" Padding="5,0"
                           Foreground="{StaticResource Editor.FontBrush}" />

                </Grid>
                <Grid Margin="0,5">
                    <Border CornerRadius="3" BorderBrush="{StaticResource Editor.Window.GrayBrush6}"
                            BorderThickness="1" Margin="5">
                        <StackPanel Margin="5,15,5,5">
                            <DockPanel Margin="5,5,5,0">
                                <TextBlock Text="Width" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Foreground="{StaticResource Editor.FontBrush}" />
                                <util:ScalarBox x:Name="widthScalarBoxPlane" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="5,5,5,0">
                                <TextBlock Text="Length" Width="40" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Foreground="{StaticResource Editor.FontBrush}" />
                                <util:ScalarBox x:Name="lengthScalarBoxPlane" Value="1" ValueChanged="OnScalarBox_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Label Content="Size" Background="{StaticResource Editor.Window.GrayBrush3}"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left" Margin="20,-3,0,0" Padding="5,0"
                           Foreground="{StaticResource Editor.FontBrush}" />
                </Grid>
                <Button Content="Save" Width="96" Margin="5,0"></Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>